# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets
serviceAccount*.json
.env
.env.*
*.pem
dist/

# generated athlete data (rebuilt by `npm run generate`; canon + overrides are the committed source of truth)
/public/data/athletes/
/public/data/athlete-index/
/athlete-review-queue.csv
/athlete-canon-report.json
/athlete-split-review-queue.csv
/athlete-split-review-queue.json
/cluster-worksheets/
*.tmp.json

# local-only tooling / logs / artifacts
/.claude/
/.claire/
/dev-server.log
/cluster-worksheets.zip

# python bytecode
__pycache__/
*.pyc
